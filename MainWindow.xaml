<Window x:Class="JianRead.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JianRead"
        Title="阿利宙斯阅读"
        Icon="assets/app-icon.ico"
        Width="1180" Height="760"
        MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1F1E1C"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="SidebarBrush" Color="#282624" />
    <SolidColorBrush x:Key="ContentBrush" Color="#1F1E1C" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#302E2B" />
    <SolidColorBrush x:Key="HoverBrush" Color="#373431" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#403B37" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3C3935" />
    <SolidColorBrush x:Key="TextBrush" Color="#ECE8E3" />
    <SolidColorBrush x:Key="MutedBrush" Color="#AAA39B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#C7AE98" />
    <SolidColorBrush x:Key="DeepSurfaceBrush" Color="#211F1D" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1B1A18" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#68584B" />
    <SolidColorBrush x:Key="TreeActiveSelectedBrush" Color="#0878D1" />
    <SolidColorBrush x:Key="TreeInactiveSelectedBrush" Color="#263B52" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#263B52" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#ECE8E3" />
    <BooleanToVisibilityConverter x:Key="DirectoryVisibilityConverter" />

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.38" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="IconBorder" Background="{TemplateBinding Background}" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="IconBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavTabStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource DeepSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HistoryButtonStyle" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="HistoryBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HistoryBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HistoryBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RenameMenuItemStyle" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="MenuItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RenameContextMenuStyle" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <HierarchicalDataTemplate DataType="{x:Type local:FileNode}" ItemsSource="{Binding Children}">
      <Grid Margin="0,1" ToolTip="{Binding FullPath}">
        <Grid.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                       Style="{StaticResource RenameContextMenuStyle}">
            <MenuItem Header="重命名" Style="{StaticResource RenameMenuItemStyle}" CommandParameter="{Binding}" Click="RenameNode_Click" />
          </ContextMenu>
        </Grid.ContextMenu>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Path Grid.Column="0"
              Width="14"
              Height="14"
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              Stroke="{DynamicResource MutedBrush}"
              StrokeThickness="1.3"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              Fill="Transparent"
              Stretch="Uniform"
              Visibility="{Binding IsDirectory, Converter={StaticResource DirectoryVisibilityConverter}}">
          <Path.Style>
            <Style TargetType="Path">
              <Setter Property="Data" Value="M1.75,4.5 L1.75,12.1 A1.65,1.65 0 0 0 3.4,13.75 L12.6,13.75 A1.65,1.65 0 0 0 14.25,12.1 L14.25,6.35 A1.65,1.65 0 0 0 12.6,4.7 L8.15,4.7 L6.65,2.75 L3.4,2.75 A1.65,1.65 0 0 0 1.75,4.4 Z" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
                  <Setter Property="Data" Value="M1.7,5.45 L3.15,3 L6.75,3 L8.2,4.75 L13,4.75 A1.3,1.3 0 0 1 14.25,6 M1.75,5.65 L14.25,5.65 L12.8,13.3 L2.85,13.3 A1.25,1.25 0 0 1 1.65,11.9 Z" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Path.Style>
        </Path>
        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding ExtensionLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </HierarchicalDataTemplate>

    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="5,4" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <Border x:Name="HeaderBorder"
                      Background="Transparent"
                      CornerRadius="6"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="PART_Header"
                                  ContentSource="Header"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Margin="18,0,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource TreeActiveSelectedBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True" />
                  <Condition Property="Selector.IsSelectionActive" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource TreeInactiveSelectedBrush}" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="220" MaxWidth="520" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
      <Grid Margin="12,13,12,11">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,11">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="25" Height="25" CornerRadius="7" ClipToBounds="True">
            <Image Source="assets/app-icon.png" Stretch="UniformToFill" />
          </Border>
          <TextBlock Grid.Column="1" Text="阿利宙斯阅读" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="15" Margin="9,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <Button Grid.Row="1" Style="{StaticResource PrimaryButtonStyle}" Click="ChooseFolder_Click" ToolTip="快捷键 Ctrl+O">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
            <TextBlock Text="选择阅读文件夹" />
          </StackPanel>
        </Button>

        <Border Grid.Row="2" Background="{DynamicResource DeepSurfaceBrush}" CornerRadius="9" Padding="3" Margin="0,12,0,10">
          <UniformGrid Columns="2">
            <RadioButton x:Name="DirectoryTab" Content="目录" GroupName="SidebarTabs" Style="{StaticResource NavTabStyle}" IsChecked="True" Checked="DirectoryTab_Checked" />
            <RadioButton x:Name="HistoryTab" Content="历史" GroupName="SidebarTabs" Style="{StaticResource NavTabStyle}" Checked="HistoryTab_Checked" />
          </UniformGrid>
        </Border>

        <Grid Grid.Row="3" Margin="7,0,3,5">
          <TextBlock x:Name="PanelHeadingText" Text="阅读节点" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
          <StackPanel x:Name="NodeActions" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RefreshNodeButton" Style="{StaticResource IconButtonStyle}" Width="27" Height="27" Click="RefreshNode_Click" ToolTip="刷新阅读节点">
              <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
            </Button>
            <Button x:Name="RemoveNodeButton" Style="{StaticResource IconButtonStyle}" Width="27" Height="27" Click="RemoveNode_Click" ToolTip="移除所选阅读节点" IsEnabled="False">
              <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
            </Button>
          </StackPanel>
          <Button x:Name="ClearHistoryButton" Content="清空" Style="{StaticResource IconButtonStyle}" Width="42" Height="27" HorizontalAlignment="Right" Click="ClearHistory_Click" Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="4">
          <TreeView x:Name="LibraryTree"
                    ItemsSource="{Binding Libraries}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectedItemChanged="LibraryTree_SelectedItemChanged"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />

          <ScrollViewer x:Name="HistoryScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding HistoryGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,4,0,9">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12" Margin="8,3,8,4" TextTrimming="CharacterEllipsis" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource HistoryButtonStyle}" Click="HistoryItem_Click" CommandParameter="{Binding}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                              <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="8,1,0,0" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel x:Name="EmptyLibraryPanel" VerticalAlignment="Center" Margin="22" IsHitTestVisible="False">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,10" />
            <TextBlock Text="选择一个文件夹开始阅读" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
          </StackPanel>

          <StackPanel x:Name="EmptyHistoryPanel" VerticalAlignment="Center" Margin="22" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,10" />
            <TextBlock Text="打开文档后，会在这里自动记录" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="7,11,7,0">
          <TextBlock x:Name="LibraryStatusText" Text="0 个阅读节点" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
        </Border>
      </Grid>
    </Border>

    <GridSplitter Grid.Column="1"
                  Width="5"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  Background="{DynamicResource BorderBrush}"
                  Cursor="SizeWE"
                  ShowsPreview="False"
                  ToolTip="拖动调整目录宽度" />

    <Grid Grid.Column="2" Background="{DynamicResource ContentBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
        <RowDefinition Height="35" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="17,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="BreadcrumbRoot" Text="阿利宙斯阅读" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="170" />
            <TextBlock x:Name="BreadcrumbSeparatorOne" Text="  ›  " Foreground="#706A64" />
            <TextBlock x:Name="BreadcrumbFolder" Text="欢迎" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="210" />
            <TextBlock x:Name="BreadcrumbSeparatorTwo" Text="  ›  " Foreground="#706A64" />
            <TextBlock x:Name="BreadcrumbFile" Text="开始阅读" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SaveEditButton" Style="{StaticResource IconButtonStyle}" Click="SaveEdit_Click" ToolTip="保存 (Ctrl+S)" Visibility="Collapsed">
              <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
            </Button>
            <Button x:Name="EditModeButton" Style="{StaticResource IconButtonStyle}" Width="56" Click="EditMode_Click" ToolTip="编辑 Markdown" IsEnabled="False">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="EditModeIcon" Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" />
                <TextBlock x:Name="EditModeText" Text="编辑" FontSize="11" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource IconButtonStyle}" Click="DecreaseFont_Click" ToolTip="减小字号 (Ctrl+-)">
              <TextBlock Text="A−" FontSize="12" />
            </Button>
            <Button Style="{StaticResource IconButtonStyle}" Click="IncreaseFont_Click" ToolTip="增大字号 (Ctrl++)">
              <TextBlock Text="A+" FontSize="12" />
            </Button>
            <Button Style="{StaticResource IconButtonStyle}" Click="OpenInExplorer_Click" ToolTip="在资源管理器中显示">
              <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <FlowDocumentScrollViewer x:Name="ReaderScrollViewer"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsToolBarVisible="False"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  SelectionBrush="{DynamicResource SelectionBrush}" />

        <Grid x:Name="EditHost" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="260" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="260" />
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0" Background="{DynamicResource EditorBackgroundBrush}">
            <Grid.RowDefinitions>
              <RowDefinition Height="34" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="13,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Markdown 源码" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                <TextBlock x:Name="UnsavedDotText" Text="  ● 未保存" Foreground="{DynamicResource AccentBrush}" FontSize="10" Visibility="Collapsed" />
              </StackPanel>
            </Border>
            <TextBox x:Name="SourceEditor"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="Transparent"
                     Foreground="{DynamicResource TextBrush}"
                     CaretBrush="{DynamicResource AccentBrush}"
                     SelectionBrush="{DynamicResource SelectionBrush}"
                     BorderThickness="0"
                     Padding="18,16,18,30"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="14"
                     SpellCheck.IsEnabled="False"
                     TextChanged="SourceEditor_TextChanged" />
          </Grid>

          <GridSplitter Grid.Column="1"
                        Width="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeDirection="Columns"
                        ResizeBehavior="PreviousAndNext"
                        Background="{DynamicResource BorderBrush}"
                        Cursor="SizeWE" />

          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="34" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="13,0">
              <TextBlock Text="实时预览" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
            </Border>
            <FlowDocumentScrollViewer x:Name="EditPreviewScrollViewer"
                                      Grid.Row="1"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsToolBarVisible="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      SelectionBrush="{DynamicResource SelectionBrush}" />
          </Grid>
        </Grid>
      </Grid>

      <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="36" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="DocumentStatusText" Grid.Column="0" Text="本地阅读 · 未打开文件" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
          <TextBlock x:Name="CharacterCountText" Grid.Column="1" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0" />
          <Button x:Name="ThemeToggleButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Click="ThemeToggle_Click" ToolTip="切换白天模式">
            <TextBlock x:Name="ThemeIconText" Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
